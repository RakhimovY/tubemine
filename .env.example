# YouTube Data API v3 key
# Create at: https://console.cloud.google.com -> APIs & Services -> Credentials -> API Key
YT_API_KEY=

# Vercel KV / Upstash Redis (auto-populated via `vercel env pull .env.local`)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# Supabase (Phase 1)
# Create project at https://supabase.com/dashboard, then Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Polar (Phase 1)
# Get token at https://polar.sh -> Settings -> Developers -> New Token
# Set NEXT_PUBLIC_POLAR_SERVER to 'sandbox' for testing, 'production' for live
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO_ID=
NEXT_PUBLIC_POLAR_SERVER=sandbox

# Resend (Phase 1)
# Get key at https://resend.com -> API Keys
RESEND_API_KEY=
# Sender identity for outbound emails (welcome, past_due, etc.).
# Domain must be verified in Resend; defaults to onboarding@resend.dev sandbox.
RESEND_FROM=

# Resend webhook signing secret (Phase 7b, TUB-8)
# Generated when you add a webhook in Resend dashboard -> Webhooks.
# Used to verify svix-signature header on POST /api/inbound/resend.
RESEND_WEBHOOK_SECRET=

# Origin (for OAuth callbacks and emails)
# Use https://tubemine.tech or your custom domain in production
NEXT_PUBLIC_ORIGIN=http://localhost:3000

# Vercel Cron auth (production only; long random string)
CRON_SECRET=
