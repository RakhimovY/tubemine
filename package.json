{
  "name": "tubemine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "YouTube audience analytics: sentiment, top words, and emoji insights via the YouTube Data API. Free. No setup.",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=test vitest run && node scripts/check-message-parity.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "i18n:check": "node scripts/check-message-parity.mjs",
    "video:voiceover": "node scripts/generate-hero-voiceover.mjs",
    "video:render:hero": "remotion render src/remotion/index.tsx tubemine-hero public/videos/tubemine-hero-demo.mp4 --codec=h264 --crf=20",
    "video:render:hero:ru": "remotion render src/remotion/index.tsx tubemine-hero-ru public/videos/tubemine-hero-demo-ru.mp4 --codec=h264 --crf=20",
    "video:poster:hero": "remotion still src/remotion/index.tsx tubemine-hero public/videos/tubemine-hero-poster.png --frame=930",
    "video:poster:hero:ru": "remotion still src/remotion/index.tsx tubemine-hero-ru public/videos/tubemine-hero-poster-ru.png --frame=930",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:ui": "NODE_ENV=test vitest --ui",
    "test:coverage": "NODE_ENV=test vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@googleapis/youtube": "^31.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polar-sh/nextjs": "^0.9.6",
    "@polar-sh/sdk": "^0.47.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-virtual": "^3.13.24",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.16.0",
    "mcp-handler": "^1.1.0",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.474",
    "@remotion/media": "^4.0.474",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "remotion": "^4.0.474",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "msw"
    ]
  }
}
